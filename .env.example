# PostgreSQL connection string (Neon or Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional Google OAuth. Create credentials in Google Cloud Console and set
# the authorized redirect URI to http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend account verification and password reset mail
RESEND_API_KEY="re_replace-with-your-resend-api-key"
EMAIL_FROM="JFO Tech <accounts@example.com>"

# Set to true only when hosting behind a trusted reverse proxy.
AUTH_TRUST_HOST="true"

# Paystack test keys: https://dashboard.paystack.com/#/settings/developer
# Use test keys locally; never expose the secret key with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_me"